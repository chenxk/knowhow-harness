# offline: 不调用模型，脚本策略 + 模板回答。live: 需要下面的模型密钥。
KNOWHOW_MODE=live
KNOWHOW_CHAT_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# 设为 true 时，工具来自 config/mcp.yaml，而不是内置 lookup_note。
KNOWHOW_MCP_ENABLED=false

# 两项都有值时，LangGraph 运行会写入 Langfuse。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
